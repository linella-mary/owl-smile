# --- Попадает в сборку расширения (не секреты) ---
# Репозиторий с данными в GitFlic (публичный)
WXT_GITFLIC_OWNER=your_login
WXT_GITFLIC_REPO=owl-smile-data
WXT_GITFLIC_BRANCH=master
# Логин для push — псевдоним пользователя, создавшего токен развёртывания
WXT_GITFLIC_USER=your_login
# Админ страницы загрузки (один): ник и отпечаток личного ключа — создаёт `npm run admin:key -- <ник>`.
# Пусто — админского режима нет: все, у кого есть ключ доступа, могут всё.
WXT_ADMIN_NICK=
WXT_ADMIN_KEY_SHA256=

# --- Только для скриптов на вашем компьютере, в сборку НЕ попадает ---
# Токен развёртывания репозитория данных (это и есть «ключ доступа» для друзей)
GITFLIC_DEPLOY_TOKEN=
# Проект с кодом и релизами расширения + личный API-токен GitFlic (для npm run release)
GITFLIC_CODE_REPO=owl-smile
GITFLIC_API_TOKEN=
# Токен развёртывания проекта с кодом (git push кода и тегов); пусто — обычные учётные данные git
GITFLIC_CODE_DEPLOY_TOKEN=
# Подпись версии для Firefox в Mozilla (npm run sign:firefox и npm run release); пусто — без Firefox.
# https://addons.mozilla.org/ru/developers/addon/api/key/ (меню «Инструменты» → «Управление ключами API»)
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
